# ============================================================
# BandStructure AI Project — .gitignore
# ============================================================

# Secrets
configs/api_keys.env
.env

# Downloaded and derived data (kept locally, never committed)
data/raw/
data/processed/
data/annotations/

# Trained artifacts (kept locally, never committed)
artifacts/models/
artifacts/checkpoints/
artifacts/reports/
artifacts/logs/

# Migration/download staging
._server_import_*/
*.tar
*.tar.gz
*.tar.zst
*.part

# Runtime UI outputs
.gradio/

# Python/test caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage*
*.egg-info/

# Environments
.venv/
venv/

# IDE/OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
