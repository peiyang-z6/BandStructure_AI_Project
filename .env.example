# Copy to .env only for an operator-managed HTTPS/OAuth deployment.
# Never commit .env. The default local deployment needs none of these settings.
BAND_MCP_PORT=8765
BAND_MCP_AUTH_MODE=bearer
# BAND_MCP_AUTH_MODE=oauth
# BAND_MCP_PUBLIC_URL=https://mcp.example.org/mcp
# BAND_MCP_OAUTH_ISSUER=https://identity.example.org/realms/bandstructure
# BAND_MCP_OAUTH_JWKS=https://identity.example.org/realms/bandstructure/protocol/openid-connect/certs
# BAND_MCP_OAUTH_SUBJECT=REPLACE_WITH_EXACT_OWNER_SUBJECT
